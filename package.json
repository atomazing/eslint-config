{
	"name": "@atomazing-org/eslint-config",
	"version": "3.12.0",
	"type": "module",
	"license": "MIT",
	"author": "whoisYeshua + MarkSinD",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atomazing/eslint-config.git"
	},
	"bugs": {
		"url": "https://github.com/atomazing/eslint-config.git"
	},
	"homepage": "https://github.com/atomazing/eslint-config.git",
	"keywords": [
		"eslint",
		"atomazing"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"exports": "./index.js",
	"files": [
		"react.js",
		"unicorn.js",
		"index.js",
		"base",
		"CHANGELOG.md"
	],
	"scripts": {
		"format": "npm run format:prettier",
		"format:prettier": "npm run lint:prettier -- --write",
		"lint": "npm run lint:prettier",
		"lint:prettier": "prettier \"**/*.{json,js,ts,tsx}\" --check",
		"clean": "rimraf node_modules",
		"debug:prettier": "prettier \"./index.js\" --loglevel debug",
		"semantic-release:local-check": "semantic-release --dry-run --no-ci",
		"prepare": "husky"
	},
	"dependencies": {
		"@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
		"@eslint/js": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.8",
		"eslint-plugin-unicorn": "^65.0.1",
		"globals": "^17.14.0",
		"typescript-eslint": "^8.73.0"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"eslint": "^9.39.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.1",
		"prettier": "^3.10.1",
		"rimraf": "^6.1.4",
		"semantic-release": "^25.0.9"
	},
	"packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
	"peerDependencies": {
		"eslint": ">=9.29 <10"
	},
	"engines": {
		"node": ">=20.10"
	}
}
